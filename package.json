{
  "name": "implant",
  "displayName": "Implant",
  "description": "Give coding agents live programmatic access to the VS Code API and structural search — Find References, Rename, diagnostics, any extension command.",
  "version": "0.2.1",
  "publisher": "strangepleasures",
  "author": {
    "name": "Pavel Mikhailovskii",
    "email": "pavel.mikhailovskii@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/strangepleasures/implant.git"
  },
  "bugs": {
    "url": "https://github.com/strangepleasures/implant/issues"
  },
  "homepage": "https://github.com/strangepleasures/implant#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "mcp",
    "ai",
    "agent",
    "coding-agent",
    "copilot",
    "claude",
    "claude-code",
    "cursor",
    "llm",
    "automation",
    "language-server",
    "refactor",
    "search",
    "vscode-api"
  ],
  "icon": "assets/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Implant",
      "properties": {
        "implant.requireConfirmation": {
          "type": "boolean",
          "default": true,
          "description": "Show the approval webview before running each script."
        },
        "implant.timeoutMs": {
          "type": "number",
          "default": 0,
          "description": "Hard execution timeout per script, in milliseconds. 0 disables the timeout — the user cancels long-running scripts through the notification that appears after 10 seconds. Set to a positive number to also enforce an automatic upper bound."
        },
        "implant.port": {
          "type": "number",
          "default": 0,
          "description": "Port for the local MCP HTTP server. 0 picks an ephemeral port; the actual port and per-session bearer token are written to .vscode/implant/session.yml in every open workspace folder."
        }
      }
    },
    "commands": [
      {
        "command": "implant.installIntoWorkspace",
        "title": "Implant: Install into Workspace"
      },
      {
        "command": "implant.copyAgentInstructions",
        "title": "Implant: Copy Agent Instructions"
      }
    ],
    "chatParticipants": [
      {
        "id": "implant.assistant",
        "name": "implant",
        "fullName": "Implant",
        "description": "Ask in English, get answers or edits by running vscode.* calls in the extension host.",
        "isSticky": true
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "implant",
        "label": "Implant"
      }
    ]
  },
  "scripts": {
    "compile": "node scripts/refresh-types.mjs && tsc -p .",
    "watch": "tsc -w -p .",
    "package": "node scripts/package.mjs",
    "publish": "node scripts/package.mjs --publish",
    "test": "tsc -p test && node test/out/run-examples.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@ast-grep/lang-c": "^0.0.6",
    "@ast-grep/lang-cpp": "^0.0.6",
    "@ast-grep/lang-go": "^0.0.6",
    "@ast-grep/lang-java": "^0.0.7",
    "@ast-grep/lang-python": "^0.0.6",
    "@ast-grep/lang-rust": "^0.0.7",
    "@ast-grep/napi": "^0.45.1"
  }
}
